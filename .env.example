# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env to version control.

# Anthropic API key — used by the AI Rådgivning module (AIAdvisory.tsx)
# Obtain yours at https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=your_key_here

# NOTE: For production deployments, route AI calls through a server-side proxy
# (e.g. a Vercel Edge Function) to avoid exposing the key in the browser bundle.
